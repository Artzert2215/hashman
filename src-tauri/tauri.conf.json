{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hashman",
  "version": "1.0.0",
  "identifier": "com.artzert.hashman",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hashman",
        "width": 580,
        "height": 560,
        "minWidth": 460,
        "minHeight": 420
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
